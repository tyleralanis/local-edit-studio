    "expo-font": "~55.0.8",
    "expo-image": "~55.0.11",
    "expo-image-manipulator": "~55.0.10",
    "expo-image-picker": "~55.0.10",
    "expo-linking": "~55.0.16",
    "expo-media-library": "~55.0.10",
